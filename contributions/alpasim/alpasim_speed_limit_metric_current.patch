+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+import numpy as np
+
+from eval.data import AggregationType, MetricReturn, SimulationResult
+from eval.schema import EvalConfig, SpeedLimitScorerConfig
+from eval.scorers.base import Scorer
+
+
+def _ego_speed_mps(
+    simulation_result: SimulationResult,
+) -> tuple[list[float], list[bool]]:
+    """Estimate ego planar speed at evaluation timestamps."""
+    timestamps_us = np.asarray(simulation_result.timestamps_us, dtype=np.uint64)
+    if len(timestamps_us) == 0:
+        return [], []
+
+    ego = simulation_result.actor_trajectories["EGO"].interpolate(timestamps_us)
+    positions_xy = np.asarray(ego.positions[:, :2], dtype=np.float64)
+
+    if len(timestamps_us) == 1:
+        return [0.0], [False]
+
+    dt_s = np.diff(timestamps_us.astype(np.float64)) / 1e6
+    distance_m = np.linalg.norm(np.diff(positions_xy, axis=0), axis=1)
+    segment_speed = np.zeros_like(distance_m, dtype=np.float64)
+    segment_valid = dt_s > 0
+    np.divide(distance_m, dt_s, out=segment_speed, where=segment_valid)
+
+    speeds = np.concatenate(([segment_speed[0]], segment_speed))
+    valid = np.concatenate(([segment_valid[0]], segment_valid))
+    return speeds.tolist(), valid.tolist()
+
+
+class SpeedLimitScorer(Scorer):
+    """Configurable speed-limit compliance metrics.
+
+    Automatic posted-limit inference is intentionally deferred until AlpaSim
+    exposes a canonical source. The current trajdata ``RoadLane`` schema has no
+    speed-limit field, so this scorer accepts an explicit per-run limit instead
+    of guessing from unrelated driver/plugin constants.
+    """
+
+    def __init__(self, cfg: EvalConfig) -> None:
+        super().__init__(cfg)
+        scorer_cfg: SpeedLimitScorerConfig | None = getattr(
+            cfg.scorers, "speed_limit", None
+        )
+        self.enabled = scorer_cfg is not None and scorer_cfg.enabled
+        self.speed_limit_mps = (
+            None if scorer_cfg is None else scorer_cfg.speed_limit_mps
+        )
+        self.tolerance_mps = 0.0 if scorer_cfg is None else scorer_cfg.tolerance_mps
+
+        if self.enabled:
+            if self.speed_limit_mps is None or self.speed_limit_mps <= 0:
+                raise ValueError(
+                    "speed_limit.speed_limit_mps must be > 0 when the scorer is enabled"
+                )
+            if self.tolerance_mps < 0:
+                raise ValueError("speed_limit.tolerance_mps must be >= 0")
+
+    def calculate(self, simulation_result: SimulationResult) -> list[MetricReturn]:
+        if not self.enabled:
+            return []
+
+        speeds, valid = _ego_speed_mps(simulation_result)
+        assert self.speed_limit_mps is not None
+        limit = float(self.speed_limit_mps)
+        threshold = limit + float(self.tolerance_mps)
+        speed_over = [max(0.0, speed - limit) for speed in speeds]
+        violation = [speed > threshold for speed in speeds]
+        timestamps_us = list(simulation_result.timestamps_us)
+
+        return [
+            MetricReturn(
+                name="ego_speed_mps",
+                values=speeds,
+                valid=valid,
+                timestamps_us=timestamps_us,
+                time_aggregation=AggregationType.MAX,
+            ),
+            MetricReturn(
+                name="speed_over_limit_mps",
+                values=speed_over,
+                valid=valid,
+                timestamps_us=timestamps_us,
+                time_aggregation=AggregationType.MAX,
+            ),
+            MetricReturn(
+                name="speed_limit_violation",
+                values=violation,
+                valid=valid,
+                timestamps_us=timestamps_us,
+                time_aggregation=AggregationType.MEAN,
+            ),
+        ]
