+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+from eval.data import RenderableTrajectory
+from eval.scorers.speed_limit import SpeedLimitScorer
+
+_IDENTITY_QUAT = [0.0, 0.0, 0.0, 1.0]
+
+
+def _trajectory(timestamps_us: list[int], x: list[float]) -> RenderableTrajectory:
+    positions = np.array([[value, 0.0, 0.0] for value in x], dtype=np.float32)
+    quaternions = np.array([_IDENTITY_QUAT] * len(x), dtype=np.float32)
+    return RenderableTrajectory(
+        timestamps_us=np.array(timestamps_us, dtype=np.uint64),
+        positions=positions,
+        quaternions=quaternions,
+    )
+
+
+def _scorer(limit_mps: float = 10.0, tolerance_mps: float = 0.0) -> SpeedLimitScorer:
+    cfg = SimpleNamespace(
+        scorers=SimpleNamespace(
+            speed_limit=SimpleNamespace(
+                enabled=True,
+                speed_limit_mps=limit_mps,
+                tolerance_mps=tolerance_mps,
+            )
+        )
+    )
+    return SpeedLimitScorer(cfg)
+
+
+def _sim_result(timestamps_us: list[int], x: list[float]) -> SimpleNamespace:
+    return SimpleNamespace(
+        timestamps_us=timestamps_us,
+        actor_trajectories={"EGO": _trajectory(timestamps_us, x)},
+    )
+
+
+def test_reports_speed_excess_and_violation_fraction() -> None:
+    sim_result = _sim_result(
+        [0, 1_000_000, 2_000_000, 3_000_000],
+        [0.0, 8.0, 20.0, 35.0],
+    )
+
+    speed, over, violation = _scorer(limit_mps=10.0).calculate(sim_result)
+
+    assert speed.name == "ego_speed_mps"
+    assert speed.values == pytest.approx([8.0, 8.0, 12.0, 15.0])
+    assert over.values == pytest.approx([0.0, 0.0, 2.0, 5.0])
+    assert violation.values == [False, False, True, True]
+    assert violation.aggregate() == pytest.approx(0.5)
+
+
+def test_tolerance_is_only_applied_to_violation_flag() -> None:
+    sim_result = _sim_result([0, 1_000_000], [0.0, 10.4])
+
+    _, over, violation = _scorer(limit_mps=10.0, tolerance_mps=0.5).calculate(
+        sim_result
+    )
+
+    assert over.values == pytest.approx([0.4, 0.4])
+    assert violation.values == [False, False]
+
+
+def test_duplicate_timestamp_is_invalid_not_divide_by_zero() -> None:
+    sim_result = _sim_result([0, 0, 1_000_000], [0.0, 1.0, 6.0])
+
+    speed, _, _ = _scorer(limit_mps=4.0).calculate(sim_result)
+
+    assert speed.values == pytest.approx([0.0, 0.0, 5.0])
+    assert speed.valid == [False, False, True]
+
+
+def test_disabled_scorer_emits_no_metrics() -> None:
+    cfg = SimpleNamespace(
+        scorers=SimpleNamespace(
+            speed_limit=SimpleNamespace(
+                enabled=False,
+                speed_limit_mps=None,
+                tolerance_mps=0.0,
+            )
+        )
+    )
+    assert SpeedLimitScorer(cfg).calculate(SimpleNamespace()) == []
