+
+def prepare_TranAD_score_export(
+    loss_train: np.ndarray,
+    loss_test: np.ndarray,
+    anoms_test: np.ndarray,
+) -> dict:
+    """Build the arrays needed for held-out threshold calibration.
+
+    Keeps the existing TranAD anomaly-score definition unchanged:
+    per-parameter MSE is retained, while the global score is the mean across
+    parameters, matching ``evaluate_TranAD``.
+    """
+    loss_train = np.asarray(loss_train)
+    loss_test = np.asarray(loss_test)
+    anoms_test = np.asarray(anoms_test)
+
+    if loss_train.ndim != 2 or loss_test.ndim != 2 or anoms_test.ndim != 2:
+        raise ValueError("loss_train, loss_test, and anoms_test must all be 2D")
+    if loss_test.shape != anoms_test.shape:
+        raise ValueError(
+            f"test loss/label shapes must match, got {loss_test.shape} and {anoms_test.shape}"
+        )
+    if loss_train.shape[1] != loss_test.shape[1]:
+        raise ValueError("train/test feature counts must match")
+
+    return {
+        "train_scores_global": np.mean(loss_train, axis=1).astype(np.float32),
+        "test_scores_global": np.mean(loss_test, axis=1).astype(np.float32),
+        "test_scores_per_parameter": loss_test.astype(np.float32, copy=False),
+        "test_labels_global": (np.sum(anoms_test, axis=1) >= 1).astype(np.uint8),
+        "test_labels_per_parameter": (anoms_test >= 1).astype(np.uint8),
+    }
+
+def export_TranAD_scores(
+    model,
+    train_dataloader,
+    test_dataloader,
+    save_path,
+    alpha=0.5,
+    beta=0.5,
+    pot_q=1e-5,
+    device='cpu',
+    identifier='',
+):
+    """Run one frozen-alpha inference pass and save calibration inputs.
+
+    The export is deliberately separate from metric selection so the normal
+    evaluation result dictionaries stay small during alpha search.
+    """
+    loss_fn = nn.MSELoss(reduction='none')
+    loss_test, _, _, _, anoms_test = gen_TranAD_predictions(
+        model, loss_fn, test_dataloader, alpha=alpha, beta=beta, device=device
+    )
+    loss_train, _, _, _, _ = gen_TranAD_predictions(
+        model, loss_fn, train_dataloader, alpha=alpha, beta=beta, device=device
+    )
+    payload = prepare_TranAD_score_export(loss_train, loss_test, anoms_test)
+    np.savez_compressed(
+        save_path,
+        **payload,
+        alpha=np.float64(alpha),
+        beta=np.float64(beta),
+        pot_q=np.float64(pot_q),
+        identifier=np.asarray(identifier),
+    )
+    return {
+        "save_path": str(save_path),
+        "n_train": int(loss_train.shape[0]),
+        "n_test": int(loss_test.shape[0]),
+        "n_features": int(loss_test.shape[1]),
+    }
 
